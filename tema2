<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
    <title>Evaluación: Rompiendo Topes</title>
    
    <!-- React y ReactDOM -->
    <script crossorigin src="https://unpkg.com/react@18/umd/react.development.js"></script>
    <script crossorigin src="https://unpkg.com/react-dom@18/umd/react-dom.development.js"></script>
    <!-- Babel para JSX -->
    <script src="https://unpkg.com/@babel/standalone/babel.min.js"></script>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Html2Canvas -->
    <script src="https://html2canvas.hertzen.com/dist/html2canvas.min.js"></script>
    <!-- Confetti -->
    <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>

    <!-- Google Fonts: Inter (Muy limpia y digital) -->
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;800&display=swap');
        
        body {
            font-family: 'Inter', sans-serif;
            background-color: #0f172a; /* Slate 900 */
            color: #f8fafc;
            overscroll-behavior: none;
            -webkit-tap-highlight-color: transparent;
        }

        /* Animaciones suaves */
        .fade-enter { animation: fadeEnter 0.4s ease-out forwards; }
        .slide-up { animation: slideUp 0.3s cubic-bezier(0.16, 1, 0.3, 1) forwards; }
        
        @keyframes fadeEnter {
            from { opacity: 0; transform: scale(0.98); }
            to { opacity: 1; transform: scale(1); }
        }
        @keyframes slideUp {
            from { transform: translateY(100%); }
            to { transform: translateY(0); }
        }

        /* Efecto Neón sutil */
        .neon-border {
            box-shadow: 0 0 15px rgba(56, 189, 248, 0.3); /* Cyan glow */
        }
        
        .tap-effect:active {
            transform: scale(0.97);
            background-color: #334155; /* Slate 700 */
        }

        /* Ajuste para móviles con notch */
        .safe-bottom {
            padding-bottom: env(safe-area-inset-bottom, 20px);
        }
        
        /* Ocultar scrollbar */
        .no-scrollbar::-webkit-scrollbar { display: none; }
        .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
    </style>
</head>
<body class="h-screen w-full flex flex-col overflow-hidden">

    <div id="root" class="w-full h-full max-w-md mx-auto relative flex flex-col"></div>

    <script type="text/babel">
        const { useState, useEffect, useRef } = React;

        // ==========================================
        // ⚙️ CONFIGURACIÓN
        // ==========================================
        const NUMERO_DEL_LIDER = ""; 
        // ==========================================

        // Iconos Minimalistas Blancos
        const Icons = {
            play: (props) => <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" {...props}><path d="M8 5v14l11-7z"/></svg>,
            checkCircle: (props) => <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" {...props}><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/></svg>,
            xCircle: (props) => <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" {...props}><path d="M12 2C6.47 2 2 6.47 2 12s4.47 10 10 10 10-4.47 10-10S17.53 2 12 2zm5 13.59L15.59 17 12 13.41 8.41 17 7 15.59 10.59 12 7 8.41 8.41 7 12 10.59 15.59 7 17 8.41 13.41 12 17 15.59z"/></svg>,
            share: (props) => <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round" {...props}><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/></svg>,
            restart: (props) => <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round" {...props}><polyline points="23 4 23 10 17 10"/><polyline points="1 20 1 14 7 14"/><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"/></svg>,
            info: (props) => <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round" {...props}><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>,
            chevronRight: (props) => <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="3" strokeLinecap="round" strokeLinejoin="round" {...props}><polyline points="9 18 15 12 9 6"/></svg>
        };

        const questions = [
            {
                questionText: "¿Cuál es la premisa principal de la 'Ley del Tope'?",
                answerOptions: [
                    { answerText: "El ministerio crece sin importar lo que haga el líder.", isCorrect: false },
                    { answerText: "El crecimiento del ministerio se detiene donde el líder se detiene.", isCorrect: true },
                    { answerText: "El ministerio crece solo si hay recursos financieros.", isCorrect: false },
                    { answerText: "Los miembros siempre crecen más rápido que los líderes.", isCorrect: false },
                ],
                explanation: "Tú eres el techo de tu organización. Si tú dejas de crecer, bloqueas el crecimiento de todo el ministerio."
            },
            {
                questionText: "En la metáfora del edificio, si tú eres el ascensor y llegas al piso 8, ¿qué pasa con tu gente?",
                answerOptions: [
                    { answerText: "Suben por las escaleras al piso 20.", isCorrect: false },
                    { answerText: "Se quedan en la planta baja.", isCorrect: false },
                    { answerText: "Llegan solo hasta el piso 8 contigo.", isCorrect: true },
                    { answerText: "Buscan otro ascensor inmediatamente.", isCorrect: false },
                ],
                explanation: "Nadie puede ir más allá de donde su líder lo lleva. Tu nivel de madurez es el límite de ellos."
            },
            {
                questionText: "¿Qué consecuencia trae una gran unción sobre un carácter inmaduro?",
                answerOptions: [
                    { answerText: "Produce podredumbre y destrucción.", isCorrect: true },
                    { answerText: "Acelera la madurez del líder.", isCorrect: false },
                    { answerText: "Santifica automáticamente al líder.", isCorrect: false },
                    { answerText: "No tiene ninguna consecuencia negativa.", isCorrect: false },
                ],
                explanation: "El don sin carácter corrompe. Necesitas estructura interna para soportar el peso de la bendición."
            },
            {
                questionText: "¿Qué significa hacer la obra 'indolentemente' según Jeremías 48:10?",
                answerOptions: [
                    { answerText: "Hacerla muy rápido.", isCorrect: false },
                    { answerText: "Hacerla con negligencia, apatía o por cumplir.", isCorrect: true },
                    { answerText: "Hacerla sin dinero.", isCorrect: false },
                    { answerText: "Hacerla con mucho dolor.", isCorrect: false },
                ],
                explanation: "La indolencia es una actitud de tibieza y descuido que Dios condena severamente en el liderazgo."
            },
            {
                questionText: "Si los miembros son 'Computadoras Cuánticas', ¿tú qué eres en la analogía?",
                answerOptions: [
                    { answerText: "El antivirus.", isCorrect: false },
                    { answerText: "La electricidad.", isCorrect: false },
                    { answerText: "La Red de Internet (conexión).", isCorrect: true },
                    { answerText: "El teclado.", isCorrect: false },
                ],
                explanation: "Tú eres la conexión. Si tu red es lenta (tu liderazgo), limitas la velocidad de ellos, aunque sean potentes."
            },
            {
                questionText: "Según Proverbios 16:18, ¿dónde se origina realmente el tope?",
                answerOptions: [
                    { answerText: "En lo externo (circunstancias).", isCorrect: false },
                    { answerText: "En lo interno (soberbia, carácter).", isCorrect: true },
                    { answerText: "En la falta de apoyo.", isCorrect: false },
                    { answerText: "En el enemigo.", isCorrect: false },
                ],
                explanation: "Antes de la caída hay altivez. El problema raíz siempre está adentro: falta de gestión emocional o formación."
            },
            {
                questionText: "Según el consejo de Jetro a Moisés (Éxodo 18), ¿qué pasa si el líder no delega?",
                answerOptions: [
                    { answerText: "El líder se vuelve más fuerte.", isCorrect: false },
                    { answerText: "Desfallece el líder y también el pueblo.", isCorrect: true },
                    { answerText: "El pueblo aprende a esperar.", isCorrect: false },
                    { answerText: "Dios se agrada del esfuerzo.", isCorrect: false },
                ],
                explanation: "Un líder que lo hace todo se cansa y cansa a su gente. Delegar es vital para no ser el tope."
            },
            {
                questionText: "¿Por qué es necesaria la humildad (Prov 11:2) para quitar un tope?",
                answerOptions: [
                    { answerText: "Para caerle bien a la gente.", isCorrect: false },
                    { answerText: "Para reconocer que necesito corrección y organización.", isCorrect: true },
                    { answerText: "Para parecer más espiritual.", isCorrect: false },
                    { answerText: "La humildad no es necesaria.", isCorrect: false },
                ],
                explanation: "Sin humildad no puedes admitir que tienes un problema, y si no lo admites, no puedes cambiarlo."
            },
            {
                questionText: "¿Qué implica la 'Formación Intencional' (2 Timoteo 2:15)?",
                answerOptions: [
                    { answerText: "Esperar a que la iglesia me capacite.", isCorrect: false },
                    { answerText: "Aprender solo por experiencia.", isCorrect: false },
                    { answerText: "Procurar activamente estudiar y prepararse.", isCorrect: true },
                    { answerText: "Orar para recibir conocimiento sobrenatural.", isCorrect: false },
                ],
                explanation: "No es pasivo. Tú debes tener la intención de leer, estudiar y buscar crecimiento."
            },
            {
                questionText: "¿Cuál es el objetivo final de romper nuestros topes?",
                answerOptions: [
                    { answerText: "Ser famosos.", isCorrect: false },
                    { answerText: "Tener el ministerio más grande.", isCorrect: false },
                    { answerText: "Multiplicarnos y que otros crezcan.", isCorrect: true },
                    { answerText: "Trabajar menos.", isCorrect: false },
                ],
                explanation: "El éxito del líder es la multiplicación: que otros brillen y crezcan gracias a que tú les abriste camino."
            }
        ];

        function App() {
            const [gameState, setGameState] = useState('start');
            const [userName, setUserName] = useState('');
            const [currentQuestion, setCurrentQuestion] = useState(0);
            const [score, setScore] = useState(0);
            const [showFeedback, setShowFeedback] = useState(false);
            const [isCorrect, setIsCorrect] = useState(false);
            const [selectedAnswerIndex, setSelectedAnswerIndex] = useState(null);
            const [isSent, setIsSent] = useState(false);
            const [isGenerating, setIsGenerating] = useState(false);
            const resultCardRef = useRef(null);

            // Efecto Confeti Neón
            useEffect(() => {
                if (gameState === 'result' && score >= 7) {
                    confetti({
                        particleCount: 100,
                        spread: 70,
                        origin: { y: 0.6 },
                        colors: ['#22d3ee', '#c084fc', '#f472b6'], // Cyan, Purple, Pink
                        disableForReducedMotion: true
                    });
                }
            }, [gameState, score]);

            const handleStart = (e) => {
                e.preventDefault();
                if (userName.trim()) setGameState('quiz');
            };

            const handleAnswer = (isCorrect, index) => {
                if (showFeedback) return;
                setIsCorrect(isCorrect);
                setSelectedAnswerIndex(index);
                setShowFeedback(true);
                if (isCorrect) setScore(score + 1);
            };

            const handleNext = () => {
                const nextQuestion = currentQuestion + 1;
                if (nextQuestion < questions.length) {
                    setCurrentQuestion(nextQuestion);
                    setShowFeedback(false);
                    setSelectedAnswerIndex(null);
                } else {
                    setGameState('result');
                }
            };

            const handleRestart = () => {
                setScore(0);
                setCurrentQuestion(0);
                setGameState('start');
                setUserName('');
                setShowFeedback(false);
                setSelectedAnswerIndex(null);
                setIsSent(false);
            };

            const handleShareWhatsApp = async () => {
                setIsGenerating(true);
                const simpleHash = btoa(userName + score).slice(0, 5).toUpperCase();
                const messageText = `🎮 NIVEL COMPLETADO\n\n🎯 Misión: Topes\n👤 Player: ${userName}\n💠 Score: ${score}/${questions.length}`;

                await new Promise(resolve => setTimeout(resolve, 300));

                if (resultCardRef.current && navigator.share) {
                    try {
                        const canvas = await html2canvas(resultCardRef.current, {
                            scale: 2,
                            backgroundColor: "#1e293b", // Slate 800 para que no salga transparente
                            useCORS: true
                        });
                        
                        canvas.toBlob(async (blob) => {
                            if (blob) {
                                const file = new File([blob], "score.png", { type: "image/png" });
                                if (navigator.canShare && navigator.canShare({ files: [file] })) {
                                    try {
                                        await navigator.share({
                                            files: [file],
                                            text: messageText,
                                        });
                                        setIsSent(true);
                                    } catch (err) {
                                        openWhatsAppTextFallback(messageText);
                                    }
                                } else {
                                    openWhatsAppTextFallback(messageText);
                                }
                            }
                        });
                    } catch (error) {
                        openWhatsAppTextFallback(messageText);
                    }
                } else {
                    openWhatsAppTextFallback(messageText);
                }
                setIsGenerating(false);
            };

            const openWhatsAppTextFallback = (text) => {
                const url = `https://wa.me/${NUMERO_DEL_LIDER}?text=${encodeURIComponent(text)}`;
                window.open(url, '_blank');
                setIsSent(true);
            };

            // --- VISTA: INICIO ---
            if (gameState === 'start') {
                return (
                    <div className="flex-1 flex flex-col justify-center items-center p-8 fade-enter relative bg-slate-900">
                        {/* Decoración de fondo */}
                        <div className="absolute top-0 left-0 w-full h-1/2 bg-gradient-to-b from-cyan-900/20 to-transparent pointer-events-none"></div>
                        
                        <div className="z-10 w-full max-w-sm">
                            <div className="mb-10 text-center">
                                <div className="inline-flex items-center justify-center w-20 h-20 rounded-full bg-slate-800 border border-slate-700 shadow-2xl shadow-cyan-500/10 mb-6">
                                    <svg className="w-10 h-10 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
                                </div>
                                <h1 className="text-4xl font-extrabold text-white tracking-tight mb-2">ROMPIENDO <span className="text-cyan-400">TOPES</span></h1>
                                <p className="text-slate-400 font-medium text-sm tracking-widest uppercase">Evaluación de Liderazgo</p>
                            </div>

                            <form onSubmit={handleStart} className="space-y-4">
                                <div>
                                    <input 
                                        type="text" 
                                        value={userName}
                                        onChange={(e) => setUserName(e.target.value)}
                                        placeholder="Ingresa tu Nombre"
                                        className="w-full bg-slate-800 text-white border border-slate-700 rounded-xl px-5 py-4 text-center text-lg focus:border-cyan-500 focus:ring-1 focus:ring-cyan-500 outline-none transition-all placeholder-slate-500"
                                        required
                                    />
                                </div>
                                <button type="submit" className="w-full bg-cyan-500 hover:bg-cyan-400 text-slate-900 font-bold py-4 rounded-xl shadow-[0_0_20px_rgba(6,182,212,0.3)] transition-all active:scale-95 flex items-center justify-center gap-2 text-lg uppercase tracking-wide">
                                    <Icons.play className="w-6 h-6" /> Iniciar
                                </button>
                            </form>
                        </div>
                        
                        <div className="absolute bottom-6 text-slate-600 text-xs font-mono">v2.0 • DARK EDITION</div>
                    </div>
                );
            }

            // --- VISTA: RESULTADO ---
            if (gameState === 'result') {
                return (
                    <div className="flex-1 flex flex-col items-center justify-center p-6 bg-slate-900 fade-enter overflow-y-auto">
                        
                        <h2 className="text-white font-bold text-xl mb-6 flex items-center gap-2">
                            <span className="w-2 h-2 bg-green-500 rounded-full animate-pulse"></span> Resultado Final
                        </h2>

                        {/* TARJETA DE RESULTADO OSCURA */}
                        <div ref={resultCardRef} className="w-full max-w-sm bg-slate-800 rounded-2xl p-6 border border-slate-700 shadow-2xl relative overflow-hidden">
                            {/* Gradiente sutil superior */}
                            <div className="absolute top-0 left-0 w-full h-1 bg-gradient-to-r from-cyan-500 via-purple-500 to-pink-500"></div>
                            
                            <div className="flex justify-between items-start mb-8">
                                <div>
                                    <p className="text-slate-400 text-xs font-bold uppercase tracking-wider mb-1">Candidato</p>
                                    <h3 className="text-2xl font-bold text-white leading-none">{userName}</h3>
                                </div>
                                <div className="text-right">
                                    <p className="text-slate-400 text-xs font-bold uppercase tracking-wider mb-1">Fecha</p>
                                    <p className="text-slate-300 text-xs font-mono">{new Date().toLocaleDateString()}</p>
                                </div>
                            </div>

                            <div className="flex items-center justify-center py-6">
                                <div className="relative w-40 h-40 flex items-center justify-center">
                                    {/* Círculo de progreso SVG */}
                                    <svg className="w-full h-full transform -rotate-90">
                                        <circle cx="80" cy="80" r="70" stroke="#1e293b" strokeWidth="12" fill="none" />
                                        <circle cx="80" cy="80" r="70" stroke="#06b6d4" strokeWidth="12" fill="none" 
                                            strokeDasharray={440}
                                            strokeDashoffset={440 - (440 * score / questions.length)}
                                            strokeLinecap="round"
                                        />
                                    </svg>
                                    <div className="absolute text-center">
                                        <span className="block text-4xl font-black text-white">{score}</span>
                                        <span className="block text-xs text-slate-400 font-bold uppercase">de {questions.length}</span>
                                    </div>
                                </div>
                            </div>

                            <div className="text-center mb-4">
                                <p className={`text-lg font-bold ${score >= 7 ? 'text-green-400' : 'text-orange-400'}`}>
                                    {score === questions.length ? "¡PERFECTO!" : score >= 7 ? "¡APROBADO!" : "NECESITAS REPASAR"}
                                </p>
                            </div>
                        </div>

                        {/* BOTONES FIJOS INFERIORES */}
                        <div className="w-full max-w-sm mt-8 space-y-3 safe-bottom">
                            <button 
                                onClick={handleShareWhatsApp}
                                disabled={isGenerating}
                                className="w-full bg-slate-800 border border-slate-600 hover:bg-slate-700 text-white font-bold py-4 rounded-xl flex items-center justify-center gap-2 active:scale-95 transition-all"
                            >
                                {isGenerating ? "Procesando..." : <><Icons.share className="w-5 h-5 text-cyan-400" /> Compartir Resultado</>}
                            </button>
                            
                            <button onClick={handleRestart} className="w-full bg-transparent hover:bg-slate-800 text-slate-400 font-semibold py-4 rounded-xl flex items-center justify-center gap-2 transition-colors">
                                <Icons.restart className="w-5 h-5" /> Intentar de nuevo
                            </button>
                        </div>
                    </div>
                );
            }

            // --- VISTA: PREGUNTAS (LAYOUT MÓVIL OPTIMIZADO) ---
            return (
                <div className="flex-1 flex flex-col bg-slate-900 h-full">
                    {/* 1. Header Fijo Superior */}
                    <div className="px-6 py-4 flex justify-between items-center bg-slate-900/90 backdrop-blur-md z-10 border-b border-slate-800">
                        <div className="w-full bg-slate-800 h-2 rounded-full overflow-hidden">
                            <div 
                                className="bg-gradient-to-r from-cyan-500 to-blue-500 h-full transition-all duration-300 ease-out"
                                style={{ width: `${((currentQuestion + 1) / questions.length) * 100}%` }}
                            ></div>
                        </div>
                        <div className="ml-4 text-xs font-mono text-cyan-400 whitespace-nowrap">
                            {currentQuestion + 1} / {questions.length}
                        </div>
                    </div>

                    {/* 2. Área de Contenido con Scroll si es necesario */}
                    <div className="flex-1 overflow-y-auto no-scrollbar p-6">
                        <h2 className="text-xl md:text-2xl font-bold text-white mb-8 leading-snug">
                            {questions[currentQuestion].questionText}
                        </h2>

                        <div className="space-y-3 pb-20"> {/* Padding bottom extra para no chocar con el bottom sheet */}
                            {questions[currentQuestion].answerOptions.map((option, index) => {
                                // Lógica de estilos para estados: Normal, Seleccionado Correcto, Seleccionado Incorrecto, No Seleccionado
                                let btnClass = "w-full text-left p-5 rounded-xl border border-slate-700 bg-slate-800 transition-all active:scale-[0.98] tap-effect";
                                let textClass = "text-slate-300 font-medium";
                                
                                // Si ya se mostró feedback, deshabilitamos hover y cambiamos colores
                                if (showFeedback) {
                                    if (index === selectedAnswerIndex) {
                                        if (option.isCorrect) {
                                            btnClass = "w-full text-left p-5 rounded-xl border border-green-500 bg-green-500/10";
                                            textClass = "text-green-400 font-bold";
                                        } else {
                                            btnClass = "w-full text-left p-5 rounded-xl border border-red-500 bg-red-500/10";
                                            textClass = "text-red-400 font-bold";
                                        }
                                    } else if (option.isCorrect) {
                                        // Mostrar la correcta si nos equivocamos
                                        btnClass = "w-full text-left p-5 rounded-xl border border-green-500/30 bg-green-500/5 opacity-70";
                                        textClass = "text-green-300";
                                    } else {
                                        // Las demás opacas
                                        btnClass += " opacity-30";
                                    }
                                }

                                return (
                                    <button 
                                        key={index} 
                                        onClick={() => handleAnswer(option.isCorrect, index)}
                                        disabled={showFeedback}
                                        className={btnClass}
                                    >
                                        <span className={textClass}>{option.answerText}</span>
                                    </button>
                                );
                            })}
                        </div>
                    </div>

                    {/* 3. Panel de Feedback Deslizable (Bottom Sheet) */}
                    {showFeedback && (
                        <div className="fixed bottom-0 left-0 w-full bg-slate-800 rounded-t-3xl shadow-[0_-10px_40px_rgba(0,0,0,0.5)] border-t border-slate-700 slide-up z-20 safe-bottom">
                            <div className="p-6">
                                <div className="flex items-center gap-3 mb-3">
                                    {isCorrect ? (
                                        <Icons.checkCircle className="w-8 h-8 text-green-400" />
                                    ) : (
                                        <Icons.xCircle className="w-8 h-8 text-red-400" />
                                    )}
                                    <span className={`text-xl font-bold ${isCorrect ? 'text-green-400' : 'text-red-400'}`}>
                                        {isCorrect ? '¡Correcto!' : 'Incorrecto'}
                                    </span>
                                </div>
                                
                                <p className="text-slate-300 text-sm leading-relaxed mb-6 pl-11">
                                    {questions[currentQuestion].explanation}
                                </p>

                                <button 
                                    onClick={handleNext} 
                                    className="w-full bg-white text-slate-900 font-bold py-4 rounded-xl active:scale-95 transition-transform flex justify-center items-center gap-2"
                                >
                                    {currentQuestion === questions.length - 1 ? "Ver Resultados" : "Continuar"} <Icons.chevronRight className="w-5 h-5"/>
                                </button>
                            </div>
                        </div>
                    )}
                </div>
            );
        }

        const root = ReactDOM.createRoot(document.getElementById('root'));
        root.render(<App />);
    </script>
</body>
